{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-auc.local/contracts/lesson_plan.schema.json",
  "title": "LessonPlan",
  "description": "지도안 — 이 파이프라인의 유일한 진실. 활동지와 슬라이드는 전부 여기서 파생되며, 세 자료의 일치는 checks/ 가 기계적으로 검사한다. 구조는 사회 5-2 세안(.docx) 7개 절을 그대로 인코딩한 것이며, 약안(.md) 표는 그 부분집합으로 담긴다. 스키마로 표현할 수 없는 검사(시간 합계, 학습목표 양방향 커버리지, 게임 실행 가능성 등)는 checks/plan_checks.py 가 담당한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id", "meta", "standards", "objectives", "social_skill",
    "era", "activities", "assessment", "copyright_notice"
  ],

  "properties": {
    "trace_id": {
      "type": "string",
      "description": "작업 식별자. 파일명 규칙과 동일하게 [과목]-[학년]-[학기]-[단원]-[차시] 형태를 쓴다.",
      "examples": ["사회-5-2-2단원-9차시"]
    },

    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "semester", "subject", "unit", "period", "minutes"],
      "properties": {
        "grade": { "type": "integer", "minimum": 1, "maximum": 6 },
        "semester": { "type": "integer", "enum": [1, 2] },
        "subject": {
          "type": "string",
          "enum": ["국어", "사회", "도덕", "수학", "과학", "실과", "체육", "음악", "미술", "영어", "창의적체험활동"]
        },
        "unit": { "type": "string", "minLength": 1 },
        "sub_unit": {
          "type": ["string", "null"],
          "description": "소단원. 사회 5-2 약안이 소단원 단위이므로 추적에 쓴다.",
          "examples": ["2-2 조선 후기"]
        },
        "period": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "몇 차시 중 몇 번째인지.",
          "examples": ["9/14"]
        },
        "sub_unit_period": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "소단원 안에서 몇 번째인지. 세안 머리표가 '1/14차시 (소단원 1/7)' 로 둘을 함께 인쇄한다.",
          "examples": ["1/7"]
        },
        "minutes": {
          "type": "integer",
          "enum": [40, 45, 80, 90],
          "description": "초등 1차시는 40분. 블록수업은 80분."
        },
        "textbook_pages": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "maxItems": 2,
          "description": "[시작쪽, 끝쪽]. 교과서 활동을 대체하더라도 진도표·평가 근거로 남긴다."
        },
        "teacher_guide_pages": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "maxItems": 2,
          "description": "지도서 쪽수 [시작, 끝]. 세안 머리표의 '교과서 70~75쪽 (지도서 156~163쪽)' 중 괄호 안."
        },
        "lesson_title": {
          "type": ["string", "null"],
          "description": "본시 주제. 단원명과 다른, 이 차시만의 제목. 세안 머리표 항목.",
          "examples": ["단원 열기 — 유교 문화와 조선 (유교 문화 축제에서 사라진 동생 찾기)"]
        }
      }
    },

    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9][가-힣]{1,2}[0-9]{2}-[0-9]{2}$",
        "description": "성취기준 코드. 대괄호 없는 정규형으로 저장한다(실물 표기는 [6사05-02]). curriculum/standards.sqlite 에 실재해야 하며, 없으면 작업 실패."
      },
      "examples": [["6사05-02"]]
    },

    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^O[0-9]+$" },
          "text": {
            "type": "string",
            "minLength": 5,
            "description": "성취기준을 학생이 이해할 수 있는 '~할 수 있다' 한 문장으로 바꾼 것."
          }
        }
      }
    },

    "learning_problem": {
      "type": ["string", "null"],
      "description": "공부할 문제. 학습목표('~할 수 있다')와 달리 칠판에 그대로 쓰는 한 문장이며, 학생에게 말하는 어투다. 세안 도입의 '▶ 학습 문제 확인' 과 판서 계획 첫 줄이 같은 문장이다.",
      "examples": ["유교 문화가 조선 사람들의 생활에 어떤 영향을 주었는지 살펴보고, 단원 탐구 질문을 만들어 보자."]
    },

    "success_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 },
      "description": "학습목표와 구별되는 성공 기준. '무엇이 보이면 도달인가'를 학생 언어로. 실물 3차시 슬라이드에 4개가 인쇄되어 있었다."
    },

    "social_skill": {
      "type": "string",
      "minLength": 2,
      "description": "이 차시에서 기를 사회적 기술. 약안·세안 모두의 필수 항목.",
      "examples": ["끝까지 듣기", "근거를 들어 말하기", "역할 지키기"]
    },

    "teaching_model": {
      "type": ["string", "null"],
      "description": "수업모형. 세안 헤더 항목.",
      "examples": ["탐구학습", "문제해결학습", "협동학습"]
    },

    "theme": {
      "type": ["string", "null"],
      "description": "차시 서사·메타포. 실물 예: '설계 스튜디오', '2045 도시 관제', '윤리 복구실'."
    },

    "era": {
      "type": "string",
      "enum": ["선사", "삼국", "고려", "조선", "근대", "해당없음"],
      "description": "슬라이드 팔레트를 결정한다. contracts/era_palettes.json 참조. 사회 외 과목은 '해당없음'."
    },

    "activities": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/activity" }
    },

    "prohibitions": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "description": "이 수업에서 하지 말아야 할 것. 실물에서 반복되는 저작 규칙. 예: '정답 선노출 금지', '속도 경쟁·탈락·순위 언어 사용 금지'. teacher_do 는 '해야 할 것'만 담으므로 별도 필드가 필요하다."
    },

    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["misconception", "correction"],
        "properties": {
          "misconception": { "type": "string", "minLength": 3 },
          "correction": { "type": "string", "minLength": 3 }
        }
      },
      "description": "예상되는 오개념과 교정 방법."
    },

    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "duty"],
        "properties": {
          "name": { "type": "string" },
          "duty": { "type": "string" },
          "rotates": { "type": "boolean", "default": false }
        }
      },
      "description": "모둠 내 역할 분담. 예: 안전 지킴이 / 기록·설명 담당."
    },

    "group_setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "integer", "minimum": 2, "maximum": 6, "description": "한 모둠 인원" },
        "group_count": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 12,
          "description": "우리 반 모둠 수. 담임 확인(2026-07-29): **6개 모둠.** 모둠 배부 인쇄량이 이 수로 정해진다.",
          "examples": [6]
        },
        "composition": { "type": ["string", "null"], "description": "예: '이질모둠'" },
        "numbering": { "type": ["string", "null"], "description": "예: '번호 1~4'. 세안의 '1번부터 시계 방향으로' 가 이걸 전제한다" }
      },
      "description": "모둠 편성. 약안 머리말에 있고(4인 이질모둠 / 번호 1~4) 세안에는 없는데, 세안 본문이 이 전제 위에서 쓰인다. 번호순으로·시계돌리기처럼 인원과 번호를 전제하는 구조에 필요하다."
    },

    "group_contingency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_3": { "type": ["string", "null"], "description": "3명 모둠일 때 조정 방법" },
        "size_5": { "type": ["string", "null"], "description": "5명 모둠일 때 조정 방법" },
        "absent": { "type": ["string", "null"], "description": "결석으로 역할이 빌 때 대처" }
      },
      "description": "모둠 인원이 4명이 아닐 때. 직소·번호순으로처럼 인원 전제가 있는 구조에서 실제로 필요하다."
    },

    "ops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prep_minutes": { "type": "integer", "minimum": 0 },
        "copies": { "type": "integer", "minimum": 0, "description": "인쇄 부수" },
        "duplex": { "type": ["string", "null"], "enum": ["단면", "양면-긴쪽", "양면-짧은쪽", null] },
        "cut_count": { "type": "integer", "minimum": 0, "description": "절취 횟수. 0이 목표" },
        "no_copy_alternative": { "type": ["string", "null"], "description": "인쇄가 불가능할 때의 대안" },
        "extra_materials": { "type": "array", "items": { "type": "string" } }
      },
      "description": "교실 운영·인쇄 정보. 실물 교사용 문서가 항상 이 블록으로 시작한다."
    },

    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "criteria"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["관찰평가", "서술형", "실기평가", "산출물평가", "자기평가", "동료평가"]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["moment"],
            "properties": {
              "moment": { "type": "string", "description": "언제 관찰하는가. 예: 'A2 짝 비교 중', '활동2'" },
              "criterion": {
                "type": ["string", "null"],
                "description": "3수준으로 나누지 않는 단일 기준. 실물 세안의 사회적 기술 행은 상/중/하 없이 한 줄로만 적혀 있다 — 없는 수준을 지어내지 않으려고 둔 자리다. levels 와 둘 중 하나는 있어야 한다."
              },
              "element": { "type": ["string", "null"], "description": "평가 요소. 세안 평가 계획 표의 첫 열. 예: '탐구 질문 만들기'" },
              "method": {
                "type": ["string", "null"],
                "description": "이 관찰 장면의 평가 방법. 세안 평가 계획 표의 '방법' 열. 예: '관찰·질문 띠지'"
              },
              "evidence": { "type": ["string", "null"], "description": "무엇을 보고 판단하는가" },
              "scale": {
                "type": "string",
                "enum": ["도달3", "상중하"],
                "default": "도달3",
                "description": "루브릭 척도 이름. 실과 교사용 문서는 도달/부분도달/지원필요, 사회 세안은 상/중/하를 쓴다. 둘은 같은 3수준이지만 표기가 다르고, 문서에 인쇄되는 글자가 다르므로 데이터로 구분한다."
              },
              "levels": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "도달": { "type": "string" },
                  "부분도달": { "type": "string" },
                  "지원필요": { "type": "string" },
                  "상": { "type": "string" },
                  "중": { "type": "string" },
                  "하": { "type": "string" },
                  "하_support": {
                    "type": ["string", "null"],
                    "description": "최하 수준 학생에게 즉시 주는 지원책. 세안이 '하 … → 질문 문장틀 제공' 처럼 루브릭 안에 붙여 둔다. 수준 서술만 있고 지원책이 없으면 관찰이 판정으로 끝나 지도로 이어지지 않는다."
                  }
                }
              }
            },
            "anyOf": [
              { "required": ["levels"] },
              { "properties": { "criterion": { "type": "string", "minLength": 5 } }, "required": ["criterion"] }
            ],
            "allOf": [
              {
                "$comment": "척도를 골랐으면 그 척도의 세 칸이 다 있어야 한다 — 두 표기를 섞어 쓰면 문서에 절반만 인쇄된다",
                "if": {
                  "properties": { "scale": { "const": "상중하" } },
                  "required": ["scale", "levels"]
                },
                "then": {
                  "properties": { "levels": { "required": ["상", "중", "하"] } }
                }
              },
              {
                "if": {
                  "not": { "properties": { "scale": { "const": "상중하" } }, "required": ["scale"] },
                  "required": ["levels"]
                },
                "then": {
                  "properties": { "levels": { "required": ["도달", "부분도달", "지원필요"] } }
                }
              }
            ]
          },
          "description": "3수준 루브릭 × 관찰 장면. 세안 '■ 평가 계획' 표와 실과 교사용 문서 루브릭이 같은 자리에 들어온다."
        },
        "feedback_sentences": {
          "type": "array",
          "items": { "type": "string" },
          "description": "즉시 피드백 문장. 예: '___의 쓰임이 보여요. 이제 ___을 숫자로 표시해 봅시다.'"
        },
        "exit_check": {
          "type": "array",
          "items": { "type": "string" },
          "description": "출구 점검 문항. 학생이 스스로 도달을 확인한다."
        }
      }
    },

    "differentiation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "below": { "type": "string", "description": "느린 학습자 지원 방안" },
        "above": { "type": "string", "description": "빠른 학습자 심화 방안" },
        "support_frames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "지원이 필요한 학생에게 주는 문장틀."
        }
      }
    },

    "closing_sentence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["template", "answer"],
      "properties": {
        "template": {
          "type": "string",
          "description": "빈칸이 있는 문장. 화면과 판서에 그대로 나간다.",
          "examples": ["조선은 ____를 바탕으로 세운 나라다."]
        },
        "answer": {
          "type": "string",
          "description": "빈칸을 채운 완성 문장. 정리 단계의 도달 확인 문장이다.",
          "examples": ["조선은 유교를 바탕으로 세운 나라다."]
        }
      },
      "description": "정리의 '오늘의 한 문장'. 사회 5-2 전 차시 공통 마무리 형식(① 한 문장 → ② OX 4문제)의 앞쪽."
    },

    "next_period_preview": {
      "type": ["string", "null"],
      "description": "차시 예고. 세안 정리 단계의 마지막 블록.",
      "examples": ["다음 시간에는 조선이 세운 새 도읍 '한양'에 숨어 있는 유교 정신을 찾아봅니다."]
    },

    "guidance_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 10 },
      "description": "세안 마지막 절 '■ 지도상의 유의점'. 개별 활동이 아니라 차시 전체에 걸리는 지도 원칙이다. 활동별 ※ 주의는 activities[].cautions 에 적는다.",
      "examples": [["단원 도입 차시이므로 지식 전달보다 '궁금증 만들기'에 초점을 둔다."]]
    },

    "safety_notice": {
      "type": ["string", "null"],
      "description": "안전 고지. 도구·실습이 있는 차시에 필요. 저작권 고지와 별개다."
    },

    "privacy_notice": {
      "type": ["string", "null"],
      "description": "개인정보 고지. 촬영·공개가 있는 차시에 필요."
    },

    "sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "참고한 자료. materials/inbox/ 의 파일명 또는 교과서 쪽수."
    },

    "copyright_notice": {
      "type": "string",
      "const": "신리초 5-5 수업용 · 외부 배포 금지"
    }
  },

  "$defs": {
    "block": {
      "$comment": "세안 본문의 ▶ 덩어리 하나.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "description": "▶ 뒤에 오는 덩어리 제목.",
          "examples": ["미니 모둠세우기 — “오늘의 기분 날씨” (돌아가며 말하기)", "학습 문제 확인"]
        },
        "procedure": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "description": "①②③ 로 번호 매겨 인쇄되는 절차. 학생이 무엇을 어떤 순서로 하는지. 협동 구조를 실제로 굴리는 대목이다.",
          "examples": [["단서 종이를 받으면 '태웅이는 ○○ 체험관에 있을 것 같다, 왜냐하면~' 을 쓰기", "시계 방향으로 넘기기", "친구 답에 새로운 생각 더하기"]]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text"],
            "properties": {
              "speaker": {
                "type": "string",
                "enum": ["T", "S", "—"],
                "description": "T=교사 발화, S=학생 예상 반응, —=발화가 아닌 안내문(학습 문제 제시 등). 세안은 T/S 를 콜론 없이 앞에 붙여 인쇄한다."
              },
              "text": { "type": "string", "minLength": 2 }
            }
          },
          "description": "실제 대사. S 는 예상 반응이며 세안에서 큰따옴표로 인쇄된다."
        }
      }
    },

    "game": {
      "$comment": "게임 명세. 담임 결정(2026-07-29): 게임은 지도안 안에 명세로 두고 HTML 을 생성하지 않는다. 이 블록만 따로 읽어도 교실에서 굴릴 수 있어야 한다.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "premise", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "premise": {
          "type": "string",
          "minLength": 10,
          "description": "상황 설정. 교사가 학생에게 말해 주는 이야기.",
          "examples": ["동생 태웅이가 축제에서 사라졌다. 가족의 말 속 단서로 어느 체험관에 있을지 추측한다."]
        },
        "clue_source": {
          "type": ["string", "null"],
          "description": "학생이 무엇을 근거로 판단하는가. 이게 비면 추측이 근거 없는 찍기가 된다.",
          "examples": ["할머니·할아버지·아빠·엄마의 말 4개 (단서 종이)"]
        },
        "answer_format": {
          "type": ["string", "null"],
          "description": "답의 **형태**. 예: '○○ 체험관'",
          "examples": ["○○ 체험관"]
        },

        "answer": {
          "type": ["string", "null"],
          "description": "**정답 자체. 교사용이다.**\n\nanswer_format 은 '○○ 체험관' 이라는 틀만 알려 줄 뿐 무엇이 답인지는 말해 주지 않는다. 정답이 없으면 게임 명세만 읽은 교사가 학생 답을 판정할 수 없다 — 담임의 R8 기준('게임 부분만 따로 읽어도 굴릴 수 있는가')이 여기서 무너진다. 실제로 이 자리가 비어 있어서 담임에게 물어봐야 했다(2026-07-29).\n\n**활동지에 인쇄되면 안 된다.** checks/cross_checks.py 가 활동지 발문·문장틀에 이 문자열이 새어 나갔는지 본다. 정답이 없는 확산적 활동은 null 로 둔다.",
          "examples": ["선비 문화 체험관"]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 },
          "description": "학생이 하는 절차."
        },
        "sentence_stem": {
          "type": ["string", "null"],
          "description": "학생이 채워 쓰는 문장 시작. 이게 있으면 쓸 줄 몰라 멈추는 학생이 없다.",
          "examples": ["태웅이는 ○○ 체험관에 있을 것 같다, 왜냐하면~"]
        },
        "materials": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "게임에 필요한 물건. 활동의 materials 에도 반영돼야 한다(checks 가 대조). 실물 세안에서 '단서 종이'가 자료 칸에서 빠져 있었다."
        },
        "rounds": { "type": ["integer", "null"], "minimum": 1 },
        "scoring": {
          "type": ["string", "null"],
          "description": "점수 계산 방법. **선택이다.** 실물 1차시 활동1은 의도적으로 비어 있다(※정답 찾기보다 '그림 속 유교 문화 요소 발견'이 목적). 억지로 채우면 확산적 활동이 정답 맞히기로 변질된다."
        },
        "win_condition": {
          "type": ["string", "null"],
          "description": "무엇이 성공인가. scoring 과 같은 이유로 선택이다.",
          "examples": ["다 맞혀야 통과. 하나라도 틀리면 다른 동물"]
        },
        "competition_policy": {
          "type": "string",
          "enum": ["순위공개", "모둠내점수만", "경쟁없음"],
          "default": "모둠내점수만",
          "description": "담임 결정(2026-07-29): 차시마다 고른다. 실과 지도안의 '속도 경쟁·순위·탈락 언어 금지' 와 사회의 경쟁형 게임이 부딪히지 않도록 정책을 데이터로 둔다. prohibitions 와 모순되면 checks 가 실패시킨다."
        },
        "teacher_script": {
          "type": "array",
          "items": { "type": "string", "minLength": 5 },
          "description": "교사가 그대로 읽어도 되는 안내 대사."
        }
      },
      "allOf": [
        {
          "$comment": "절차만 있고 말할 거리가 없으면 교실에서 굴릴 수 없다 — 문장틀이든 교사 대사든 하나는 있어야 한다",
          "if": { "required": ["steps"] },
          "then": {
            "anyOf": [
              { "properties": { "sentence_stem": { "type": "string", "minLength": 3 } }, "required": ["sentence_stem"] },
              { "properties": { "teacher_script": { "minItems": 1 } }, "required": ["teacher_script"] }
            ]
          }
        }
      ]
    },

    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "minutes", "objective_ids", "source", "teacher_do", "student_do", "materials", "worksheet_items"],
      "properties": {
        "id": { "type": "string", "pattern": "^A[0-9]+$" },

        "phase": { "type": "string", "enum": ["도입", "전개", "정리"] },

        "stage_label": {
          "type": ["string", "null"],
          "description": "세안 본문 표 첫 열에 인쇄되는 단계 이름. phase 만으로는 전개가 둘인지 셋인지 구분되지 않는다.",
          "examples": ["도입", "전개 활동1", "전개 활동2", "정리"]
        },

        "learning_content": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "description": "세안 본문 표 둘째 열 '학습 내용'. 이 활동에서 다루는 내용을 명사구로 나열한다. teacher_do 가 '어떻게'라면 이쪽은 '무엇을'이다.",
          "examples": [["마음 열기", "전시·경험 상기", "학습 문제 확인"]]
        },

        "minutes": { "type": "integer", "minimum": 1, "maximum": 60 },

        "slide_range": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "이 활동이 쓰는 슬라이드 번호 [시작, 끝]. 세안이 자료 칸에 '★슬라이드 5~7' 로 적는다. checks 가 겹침·빈 구간을 잡는다."
        },

        "objective_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^O[0-9]+$" },
          "description": "이 활동이 겨냥하는 학습목표. 최소 1개. 교과서를 대체할 수 있는 대신 이 연결이 유일한 방어선이다."
        },

        "source": {
          "type": "string",
          "enum": ["교과서", "대체", "혼합"],
          "description": "교과서 활동 그대로면 '교과서', 다른 활동으로 갈아끼웠으면 '대체', 일부만 바꿨으면 '혼합'."
        },

        "replaces": {
          "type": ["string", "null"],
          "description": "무엇을 대체했는지. 예: '교과서 p.59 「표 정리하기」'"
        },

        "rationale": {
          "type": ["string", "null"],
          "minLength": 10,
          "description": "왜 대체가 더 나은지. 학습목표 도달 근거를 포함할 것."
        },

        "kagan_structure": {
          "type": ["string", "null"],
          "enum": [
            "돌아가며 쓰기", "짝 점검", "생각-쓰기-짝-비교", "3단계 인터뷰",
            "모둠 단어 짝짓기", "번호순으로", "모두미 협의",
            "직소 전문가 정리지", "직소 모둠 종합지",
            "동전 내놓기", "짝 코칭", "하나 주고 하나 받기", "부채모양 뽑기", "퀴즈-퀴즈-교환",
            "동시응답", "셋 가고 하나 남기", "셋 남고 하나 가기", "두 머리 함께", "모서리 선택",
            "생각-짝-나누기", "돌아가며 말하기", "모둠 시계돌리기", "브레인라이팅",
            null
          ],
          "description": "전개 활동은 반드시 이 중 하나. 도입·정리는 null 허용. has_template=true 인 9종은 활동지 항목 역할까지 기계 검증된다."
        },

        "teacher_do": { "type": "string", "minLength": 5 },
        "student_do": { "type": "string", "minLength": 5 },

        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" },
          "description": "세안 본문 셋째 열 '교수·학습 활동 (T/S)' 의 실체. ▶ 로 시작하는 덩어리들이며, 각 덩어리 안에 절차와 T/S 대사가 들어간다. 약안에 없고 세안에만 있는 것이 바로 이것이고, 게임을 굴릴 수 있느냐가 여기서 갈린다. teacher_do·student_do 는 이 내용의 한 줄 요약이다."
        },

        "game": { "$ref": "#/$defs/game" },

        "cautions": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "description": "세안 다섯째 열의 ※ 항목. 이 활동에만 걸리는 주의. 차시 전체에 걸리는 것은 최상위 guidance_notes 에 적는다.",
          "examples": [["한 사람이 독점하지 않게 시계돌리기 규칙 유지(개인 책임)"]]
        },

        "sentence_frames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "학생이 채워 말하는 문장틀. 예: '우리 모둠은 ___을 위해 ___을 선택했다.'"
        },

        "materials": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": "세안 다섯째 열의 ★ 항목. 폐쇄 enum 이었으나 실물을 담지 못해 개방형으로 바꿨다 — '질문 띠지', 'OX 이동판(동물 카드)', '타이머', '단서 종이' 는 어느 enum 값에도 들어가지 않는다. 다만 '활동지' 라는 낱말은 특별하다: 이 값이 있으면 worksheet_items 가 비어 있을 수 없고, 없으면 비어 있어야 한다(아래 allOf).",
          "examples": [["교과서 72~73쪽", "단서 종이", "슬라이드 5~7"]]
        },

        "worksheet_items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3,}[A-Z0-9_]*$",
            "description": "활동지 항목 이름표. 실물은 번호가 아니라 이름을 쓴다: OPTION_A, PAIR_COACH, TEAM_AGREEMENT, REVISION_EVIDENCE. 영문 3글자 이상으로 시작해야 하므로 W1 같은 번호는 거부된다.",
            "maxLength": 40
          },
          "description": "이 활동에서 쓰는 활동지 항목 id. 활동지의 items[].id 와 양방향으로 일치해야 한다."
        },

        "engagement_note": {
          "type": "string",
          "description": "이 활동이 왜 학생 참여를 끌어내는지 한 줄. 검수자가 R3(재미·몰입)을 판단하는 근거."
        }
      },

      "allOf": [
        {
          "$comment": "전개 활동은 케이건 구조 필수",
          "if": { "properties": { "phase": { "const": "전개" } }, "required": ["phase"] },
          "then": {
            "properties": { "kagan_structure": { "type": "string" } },
            "required": ["kagan_structure"]
          }
        },
        {
          "$comment": "교과서를 벗어났으면 무엇을 왜 바꿨는지 반드시 남긴다",
          "if": { "properties": { "source": { "enum": ["대체", "혼합"] } }, "required": ["source"] },
          "then": {
            "properties": {
              "replaces": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 10 }
            },
            "required": ["replaces", "rationale"]
          }
        },
        {
          "$comment": "활동지를 쓴다면 항목이 있어야 하고, 항목이 있다면 활동지를 써야 한다",
          "if": {
            "properties": { "materials": { "contains": { "const": "활동지" } } },
            "required": ["materials"]
          },
          "then": { "properties": { "worksheet_items": { "minItems": 1 } } },
          "else": { "properties": { "worksheet_items": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
