{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-auc.local/contracts/textbook.schema.json",
  "title": "TextbookRegistry",
  "description": "교과서 차시별 학습목표·쪽수 등록부. 과목·학년·학기마다 파일 하나.\n\n담임 요구(2026-07-29): **\"교과서 학습목표 일치시키고. 지금은 사회 교과서만 있는데 계속 보충해줄게.\"**\n\n왜 필요한가 — 지금까지 학습목표의 출처가 약안·세안이었다. 둘 다 선생님이 쓰신 것이라 교과서가 인쇄한 목표와 어긋날 수 있고, 어긋나도 알 방법이 없었다. 성취기준을 NCIC DB 로 고정한 것과 같은 이유로 교과서 목표도 고정한다.\n\n비어 있는 과목이 있는 것은 정상이다. 없는 과목은 검사가 '미등록' 경고만 내고 지나간다 — 자료를 지어내지 않는다(CLAUDE.md B-1 과 같은 원칙).",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "grade", "semester", "units"],

  "properties": {
    "$comment": { "type": "string" },
    "$status": {
      "type": "string",
      "description": "이 파일이 지금 어디까지 채워졌는지 사람 말로. 등록부는 늘 미완성이므로, 어디까지 믿을 수 있는지를 파일 안에 적어 둔다."
    },

    "subject": { "type": "string", "minLength": 1, "examples": ["사회", "실과", "국어"] },
    "grade": { "type": "integer", "minimum": 1, "maximum": 6 },
    "semester": { "type": "integer", "enum": [1, 2] },

    "publisher": {
      "type": ["string", "null"],
      "description": "초등 사회는 검정 교과서라 출판사마다 단원 구성과 쪽수가 다르다. 모르면 null 로 두되, 쪽수를 쓰려면 결국 채워야 한다."
    },

    "curriculum": {
      "type": "string",
      "default": "2022 개정",
      "description": "교육과정. 2026학년도 5~6학년이 2022 개정 첫 적용이다."
    },

    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "lessons"],
        "properties": {
          "unit": { "type": "string", "minLength": 1 },
          "sub_unit": { "type": ["string", "null"] },
          "standards": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9][가-힣]{1,2}[0-9]{2}-[0-9]{2}$" },
            "description": "이 소단원이 다루는 성취기준. curriculum/standards.sqlite 에 실재해야 한다."
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/lesson" }
          }
        }
      }
    }
  },

  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "objective", "verified", "source"],
      "properties": {
        "period": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$",
          "description": "지도안 meta.period 와 같은 표기. 조회 키다.",
          "examples": ["1/14"]
        },

        "title": { "type": ["string", "null"], "description": "교과서 차시 제목" },

        "pages": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1,
          "maxItems": 2,
          "description": "[시작, 끝]. 지도안 meta.textbook_pages 와 대조된다."
        },

        "objective": {
          "type": "string",
          "minLength": 5,
          "description": "이 차시의 학습목표. `verified` 가 무엇을 뜻하는지 반드시 함께 본다."
        },

        "verified": {
          "type": "boolean",
          "description": "**교과서 원본과 대조했는가.**\n\ntrue  — 교과서를 펴서 확인함. 지도안이 어긋나면 **실패**.\nfalse — 아직 대조 못 함(선생님 자료에서 옮겨 적음). 어긋나면 **경고**만.\n\n성취기준에서 이미 겪은 일이다 — 학기계획표에 '웹 확인, 총론 대조 예정' 이라고 적혀 있던 5개가 나중에 NCIC 원본과 전부 일치했다. 대조 전과 후를 구분해 두지 않으면 그 확인이 있었는지 알 수 없게 된다."
        },

        "source": {
          "type": "string",
          "minLength": 3,
          "description": "이 줄을 어디서 가져왔는지. 나중에 되짚을 수 있어야 한다.",
          "examples": ["교과서 70쪽", "사회/활동지/2단원_2-1_유교조선_학습지.pdf 1쪽", "약안 2단원_2-1_유교조선.md"]
        },

        "note": { "type": ["string", "null"] }
      },

      "allOf": [
        {
          "$comment": "대조했다고 표시하려면 출처가 교과서여야 한다 — 선생님 자료를 보고 '확인함'이라 적으면 확인이 아니다",
          "if": { "properties": { "verified": { "const": true } }, "required": ["verified"] },
          "then": { "properties": { "source": { "pattern": "교과서|지도서" } } }
        }
      ]
    }
  }
}
