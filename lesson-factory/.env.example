# 복사해서 .env 로 쓰고, .env 는 절대 커밋하지 않는다 (CLAUDE.md B-3)

# --- LLM ---
ANTHROPIC_API_KEY=

# --- 텔레그램 승인 봇 (P2.5) ---
# quant-house 와 다른 봇을 쓸 것. 수업 알림이 매매 알림에 섞이면 둘 다 놓친다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 안전장치 ---
# 작업 1건당 비용 상한(원). 초과 시 중단하고 알린다.
COST_LIMIT_KRW_PER_JOB=2000
# 환율(1달러 = 몇 원). **비워 두면 비용 상한이 동작하지 않는다** — 단가는 달러이고
# 환율은 매일 바뀌어서 코드가 알 방법이 없다. 지어낸 환율로 상한을 계산하면
# 상한이 있는 척하게 되므로, 모르면 상한 없이 돌리고 그 사실을 매번 알린다.
USD_KRW=
# 재작업 최대 횟수. CLAUDE.md B-6
MAX_REVISIONS=2
# 기본값 dry_run. 실제 파일 저장은 CLI 의 --write 로만.
DRY_RUN=true

# --- 학교 정보 (산출물 푸터·파일명에 쓰임) ---
SCHOOL_NAME=신리초
# 인쇄 부수 계산에 쓰인다
CLASS_SIZE=24
CLASS_NAME=5-5
